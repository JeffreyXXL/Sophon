<UserControl
    x:Class="Sophon.UI.Controls.StatusLamp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">
    <Grid>
        <Ellipse
            x:Name="LampEllipse"
            Width="{Binding ElementName=Root, Path=Size}"
            Height="{Binding ElementName=Root, Path=Size}"
            StrokeThickness="0">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.3,0.3">
                    <GradientStop x:Name="ColorStop1" Offset="0.0" Color="White" />
                    <GradientStop x:Name="ColorStop2" Offset="0.6" Color="LightGray" />
                    <GradientStop x:Name="ColorStop3" Offset="1.0" Color="Gray" />
                </RadialGradientBrush>
            </Ellipse.Fill>

            <Ellipse.Effect>
                <DropShadowEffect
                    x:Name="LampShadow"
                    BlurRadius="10"
                    Opacity="0.5"
                    ShadowDepth="0"
                    Color="Transparent" />
            </Ellipse.Effect>
        </Ellipse>
    </Grid>
</UserControl>