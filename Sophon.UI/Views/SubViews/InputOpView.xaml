<UserControl
    x:Class="Sophon.UI.Views.InputOpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sophon.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="30"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <Grid>
        <ctrl:StatusLamp
            Margin="10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Status="{Binding Status}" />
        <StackPanel
            Margin="10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Width="20"
                FontSize="14"
                Text="{Binding CardNo, FallbackValue='0'}" />
            <TextBlock
                Width="20"
                FontSize="14"
                Text="{Binding InputNo, FallbackValue='1'}" />
            <TextBlock
                Width="100"
                FontSize="14"
                Text="{Binding Name, FallbackValue='启动按钮'}" />
        </StackPanel>
    </Grid>
</UserControl>