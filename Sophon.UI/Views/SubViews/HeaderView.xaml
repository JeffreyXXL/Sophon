<UserControl
    x:Class="Sophon.UI.Views.HeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Sophon.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="100"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid Background="#F3F6F9" MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <StackPanel Margin="30,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="30" Text="自动化软件框架" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Button
                x:Name="MinButton"
                Width="40"
                Height="40"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="MinButton_Click">
                <Image Source="/Resources/Min.png" />
            </Button>
            <Button
                x:Name="MaxButton"
                Width="40"
                Height="40"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="MaxButton_Click">
                <Image Source="/Resources/Max.png" />
            </Button>
            <Button
                x:Name="CloseButton"
                Width="40"
                Height="40"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="CloseButton_Click">
                <Image Source="/Resources/Close.png" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>