<UserControl
    x:Class="Sophon.UI.Views.AxisOpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sophon.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Height="320"
    d:DesignWidth="220"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource ButtonGroupSolid}" TargetType="hc:ButtonGroup">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <StackPanel Margin="10">

                <TextBlock
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="Green"
                    Text="{Binding AxisName, FallbackValue='移载X轴'}">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="10"
                            Opacity="0.3"
                            ShadowDepth="8"
                            Color="Gray" />
                    </TextBlock.Effect>
                </TextBlock>

                <hc:Divider Margin="0,10" LineStroke="LightGray" />

                <Grid Margin="0,0,0,10">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="当前速度" />
                    <TextBlock Grid.Row="1" Text="当前位置" />
                    <TextBlock Grid.Row="2" Text="报警代码" />
                    <TextBlock Grid.Row="3" Text="JOG距离" />

                    <TextBlock
                        Grid.Column="1"
                        Foreground="DeepSkyBlue"
                        Style="{StaticResource ShadowValueStyle}"
                        Text="{Binding CurrentSpeed, FallbackValue='1000'}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Foreground="LimeGreen"
                        Style="{StaticResource ShadowValueStyle}"
                        Text="{Binding CurrentPosition, FallbackValue='8888.88'}" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Foreground="Red"
                        Style="{StaticResource ShadowValueStyle}"
                        Text="{Binding AlarmCode, FallbackValue='80.80'}" />

                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Height="15"
                        ItemsSource="{Binding JogDistanceList}"
                        SelectedItem="{Binding SelectedJogDistance}" />

                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        FontSize="8"
                        Text="mm/s" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        FontSize="8"
                        Text="mm" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        FontSize="8"
                        Text="mm" />
                </Grid>

                <hc:ButtonGroup>
                    <Button Command="{Binding HomeCommand}" Content="原点搜索" />
                    <Button Command="{Binding EnableCommand}" Content="伺服使能" />
                </hc:ButtonGroup>

                <hc:ButtonGroup>
                    <Button Command="{Binding JogPlusCommand}" Content="JOG+" />
                    <Button Command="{Binding JogMinsCommand}" Content="JOG-" />
                </hc:ButtonGroup>

                <hc:ButtonGroup>
                    <Button Command="{Binding ResetCommand}" Content="报警复位" />
                    <Button Command="{Binding BreakCommand}" Content="解除刹车" />
                </hc:ButtonGroup>

            </StackPanel>

            <Grid
                Margin="15"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="8"
                    Text="PEL" />
                <ctrl:StatusLamp
                    Grid.Row="1"
                    Margin="5"
                    Size="10"
                    Status="{Binding IsPel}" />

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    FontSize="8"
                    Text="ORG" />
                <ctrl:StatusLamp
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    Size="10"
                    Status="{Binding IsOrg}" />

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    FontSize="8"
                    Text="REL" />
                <ctrl:StatusLamp
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="5"
                    Size="10"
                    Status="{Binding IsRel}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>