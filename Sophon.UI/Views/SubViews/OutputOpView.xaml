<UserControl
    x:Class="Sophon.UI.Views.SubViews.OutputOpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Sophon.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sophon.UI.Views.SubViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="30"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <ctrl:StatusLamp
            Margin="10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Status="{Binding Status}" />
        <Button
            Margin="5,0"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding DataContext.OutputOPCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
            CommandParameter="{Binding}">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Width="20"
                    FontSize="14"
                    Foreground="Black"
                    Text="{Binding CardNo, FallbackValue='0'}" />
                <TextBlock
                    Width="20"
                    FontSize="14"
                    Foreground="Black"
                    Text="{Binding OutputNo, FallbackValue='1'}" />
                <TextBlock
                    Width="100"
                    FontSize="14"
                    Foreground="Black"
                    Text="{Binding Name, FallbackValue='启动按钮灯'}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
