<UserControl
    x:Class="Sophon.UI.Views.BottomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sophon.UI.Views.SubViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="30"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Background="#F3F6F9">
        <Grid.Resources />
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
            <TextBlock
                Margin="5"
                VerticalAlignment="Center"
                FontSize="16"
                Text="当前用户：" />
            <TextBlock Text="{Binding CurrentUser}">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="16" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotLogin}" Value="True">
                                <Setter Property="Foreground" Value="Red" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <TextBlock
                Margin="10"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{Binding CurrentTime}" />
        </StackPanel>
    </Grid>
</UserControl>
