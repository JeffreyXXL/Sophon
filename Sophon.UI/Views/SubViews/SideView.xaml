<UserControl
    x:Class="Sophon.UI.Views.SideView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Sophon.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="220"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Image Margin="0,5,0,0" Source="/Resources/Logo.png" />
        <hc:SideMenu Grid.Row="1">
            <hc:SideMenuItem
                Command="{Binding NavigateCommand}"
                CommandParameter="HomeView"
                FontSize="18"
                Header="  系统主页">
                <hc:SideMenuItem.Icon>
                    <Image Margin="5" Source="/Resources/Home.png" />
                </hc:SideMenuItem.Icon>
            </hc:SideMenuItem>
            <hc:SideMenuItem
                Command="{Binding NavigateCommand}"
                CommandParameter="StationView"
                FontSize="18"
                Header="  工站流程">
                <hc:SideMenuItem.Icon>
                    <Image Margin="5" Source="/Resources/Station.png" />
                </hc:SideMenuItem.Icon>
            </hc:SideMenuItem>
            <hc:SideMenuItem FontSize="18" Header="  硬件操作">
                <hc:SideMenuItem.Icon>
                    <Image Margin="5" Source="/Resources/Infra.png" />
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem
                    Command="{Binding NavigateCommand}"
                    CommandParameter="AxisInfrastructureView"
                    FontSize="15"
                    Header="    伺服操作">
                    <hc:SideMenuItem.Icon>
                        <Image Margin="10" Source="/Resources/Axis.png" />
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>
                <hc:SideMenuItem
                    Command="{Binding NavigateCommand}"
                    CommandParameter="IOInfrastructureView"
                    FontSize="15"
                    Header="    IO操作">
                    <hc:SideMenuItem.Icon>
                        <Image Margin="10" Source="/Resources/IO.png" />
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>
                <hc:SideMenuItem
                    Command="{Binding NavigateCommand}"
                    CommandParameter="ProtocolInfrastructureView"
                    FontSize="15"
                    Header="    通讯操作">
                    <hc:SideMenuItem.Icon>
                        <Image Margin="10" Source="/Resources/Protocol.png" />
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>
            </hc:SideMenuItem>
            <hc:SideMenuItem
                Command="{Binding NavigateCommand}"
                CommandParameter="ParamView"
                FontSize="18"
                Header="  参数设置">
                <hc:SideMenuItem.Icon>
                    <Image Margin="5" Source="/Resources/Param.png" />
                </hc:SideMenuItem.Icon>
            </hc:SideMenuItem>
            <hc:SideMenuItem
                CommandParameter="AlarmView"
                FontSize="18"
                Header="  报警显示">
                <hc:SideMenuItem.Icon>
                    <Image Margin="5" Source="/Resources/Alarm.png" />
                </hc:SideMenuItem.Icon>
                <hc:SideMenuItem
                    Command="{Binding NavigateCommand}"
                    CommandParameter="AlarmHistoryView"
                    FontSize="15"
                    Header="    历史报警">
                    <hc:SideMenuItem.Icon>
                        <Image Margin="10" Source="/Resources/History.png" />
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>
                <hc:SideMenuItem
                    Command="{Binding NavigateCommand}"
                    CommandParameter="AlarmRegisterView"
                    FontSize="15"
                    Header="    报警注册">
                    <hc:SideMenuItem.Icon>
                        <Image Margin="10" Source="/Resources/Register.png" />
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>
            </hc:SideMenuItem>
            <hc:SideMenuItem
                Command="{Binding NavigateCommand}"
                CommandParameter="UserView"
                FontSize="18"
                Header="  用户管理">
                <hc:SideMenuItem.Icon>
                    <Image Margin="5" Source="/Resources/User.png" />
                </hc:SideMenuItem.Icon>
            </hc:SideMenuItem>
        </hc:SideMenu>

        <StackPanel Grid.Row="2">
            <hc:Divider Margin="10,0,10,10" LineStroke="LightGray" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="LightGray"
                Text="Version 1.0.0" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="LightGray"
                Text="Sophon 水滴智造" />
        </StackPanel>
    </Grid>
</UserControl>