<UserControl
    x:Class="Sophon.UI.Views.AlarmRegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:Sophon.UI.Helper"
    xmlns:local="clr-namespace:Sophon.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#F3F6F9"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <Button
                            Command="{Binding AddAlarmCommand}"
                            Content="添加报警"
                            Style="{StaticResource ButtonDashedSuccess}" />
                        <Button
                            Margin="20,0"
                            Command="{Binding DeleteAlarmCommand}"
                            Content="删除报警"
                            Style="{StaticResource ButtonDashedDanger}" />
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="保存更改"
                            Style="{StaticResource ButtonDashedInfo}" />
                        <Button
                            Margin="20,0"
                            Command="{Binding RestoreCommand}"
                            Content="恢复更改"
                            Style="{StaticResource ButtonDashedWarning}" />
                        <TextBlock
                            Margin="100,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="Gray"
                            Text="添加或删除操作后，点击【保存更改】生效，点击【恢复更改】恢复！" />
                    </StackPanel>
                    <StackPanel
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="Hidden">
                        <Button
                            Margin="10,0"
                            Command="{Binding ImportCommand}"
                            Content="导入"
                            Style="{StaticResource ButtonDashedPrimary}" />
                        <Button
                            Command="{Binding ExportCommand}"
                            Content="导出"
                            Style="{StaticResource ButtonDashedPrimary}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <DataGrid
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding RegisteredAlarms}"
                    SelectedItem="{Binding SelectedAlarm}"
                    Style="{StaticResource DataGridCommonStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding AlarmCode}"
                            Header="报警代码" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Content}"
                            Header="报警内容" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>