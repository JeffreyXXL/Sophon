<UserControl
    x:Class="Sophon.UI.Views.AlarmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:Sophon.UI.Helper"
    xmlns:local="clr-namespace:Sophon.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helper:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid>
        <TabControl BorderThickness="0">
            <hc:TabItem FontSize="18" Header="报警历史查询">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="选择起始时间筛选：" />
                        <hc:DateTimePicker Width="220" Margin="10,0" />
                        <hc:DateTimePicker Width="220" />
                        <Button Margin="10,0" Command="{Binding FilterCommand}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource ButtonDashedSuccess}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                            <Setter Property="Content" Value="取消筛选" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFiltered}" Value="False">
                                            <Setter Property="Content" Value="启用筛选" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding ActuralAlarmList}"
                        Style="{StaticResource DataGridCommonStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Time, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}"
                                Header="报警时间"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding AlarmCode}"
                                Header="报警代码" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Content}"
                                Header="报警内容" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </hc:TabItem>
            <hc:TabItem FontSize="18" Header="报警注册">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <Button
                            Command="{Binding AddAlarmCommand}"
                            Content="添加报警"
                            Style="{StaticResource ButtonDashedSuccess}" />
                        <Button
                            Margin="20,0"
                            Command="{Binding DeleteAlarmCommand}"
                            Content="删除报警"
                            Style="{StaticResource ButtonDashedDanger}" />
                        <Button
                            Command="{Binding SaveCommand}"
                            Content="保存更改"
                            Style="{StaticResource ButtonDashedInfo}" />
                        <Button
                            Margin="20,0"
                            Command="{Binding RestoreCommand}"
                            Content="恢复更改"
                            Style="{StaticResource ButtonDashedWarning}" />
                        <TextBlock
                            Margin="100,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="Gray"
                            Text="添加或删除操作后，点击【保存更改】生效，点击【恢复更改】恢复！" />
                    </StackPanel>
                    <StackPanel
                        Margin="20,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="Hidden">
                        <Button
                            Margin="10,0"
                            Command="{Binding ImportCommand}"
                            Content="导入"
                            Style="{StaticResource ButtonDashedPrimary}" />
                        <Button
                            Command="{Binding ExportCommand}"
                            Content="导出"
                            Style="{StaticResource ButtonDashedPrimary}" />
                    </StackPanel>
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding RegisteredAlarms}"
                        SelectedItem="{Binding SelectedAlarm}"
                        Style="{StaticResource DataGridCommonStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding AlarmCode}"
                                Header="报警代码" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Content}"
                                Header="报警内容" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </hc:TabItem>
        </TabControl>
    </Grid>
</UserControl>