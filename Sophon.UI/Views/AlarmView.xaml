<UserControl
    x:Class="Sophon.UI.Views.AlarmView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sophon.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="10,0" Orientation="Horizontal">
            <TextBlock
                Margin="20,0"
                VerticalAlignment="Center"
                FontSize="20"
                Text="报警实时监控" />
            <TextBlock
                Margin="40,0"
                VerticalAlignment="Center"
                FontSize="16"
                Text="选择报警等级以筛选：" />
            <ComboBox
                Width="100"
                Height="30"
                FontSize="14"
                ItemsSource="{Binding AlarmLevels}"
                SelectedItem="{Binding SelectedLevel}" />
        </StackPanel>
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding FilteredAlarmList}"
            Style="{StaticResource DataGridCommonStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Time}"
                    Header="报警时间" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Level}"
                    Header="报警等级" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Content}"
                    Header="报警内容" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>