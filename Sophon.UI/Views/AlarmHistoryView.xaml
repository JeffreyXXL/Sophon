<UserControl
    x:Class="Sophon.UI.Views.AlarmHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:Sophon.UI.Helper"
    xmlns:local="clr-namespace:Sophon.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#F3F6F9"
    mc:Ignorable="d">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Margin="10,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="选择起始时间筛选：" />
                    <hc:DateTimePicker
                        Width="220"
                        Height="20"
                        Margin="10,0"
                        SelectedDateTime="{Binding StartTime}" />
                    <hc:DateTimePicker
                        Width="220"
                        Height="20"
                        SelectedDateTime="{Binding EndTime}" />
                    <Button Margin="10,0" Command="{Binding FilterCommand}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ButtonDashedSuccess}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFiltered}" Value="True">
                                        <Setter Property="Content" Value="取消筛选" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFiltered}" Value="False">
                                        <Setter Property="Content" Value="启用筛选" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <DataGrid
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding DisplayAlarmList}"
                    Style="{StaticResource DataGridCommonStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding Time, StringFormat='{}{0:yyyy/MM/dd HH:mm:ss}'}"
                            Header="报警时间"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding AlarmCode}"
                            Header="报警代码" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Content}"
                            Header="报警内容" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>