<UserControl
    x:Class="Sophon.UI.Views.ParamView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#F3F6F9"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel Margin="10,0" Orientation="Horizontal">
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Text="选择参数分类：" />
                <ComboBox
                    Width="200"
                    Height="30"
                    FontSize="14"
                    ItemsSource="{Binding AvailableCategorys}"
                    SelectedItem="{Binding SelectedCategory}" />
                <Button
                    Margin="20,0"
                    Command="{Binding AddParamCommand}"
                    Content="添加参数"
                    Style="{StaticResource ButtonDashedSuccess}" />
                <Button
                    Command="{Binding DeleteParamCommand}"
                    Content="删除参数"
                    Style="{StaticResource ButtonDashedDanger}" />
                <Button
                    Margin="20,0"
                    Command="{Binding SaveParamCommand}"
                    Content="保存参数"
                    Style="{StaticResource ButtonDashedInfo}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <DataGrid
                AutoGenerateColumns="False"
                ItemsSource="{Binding FilteredParamConfigs}"
                SelectedItem="{Binding SelectedParam}"
                Style="{StaticResource DataGridCommonStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Name}"
                        Header="参数名称"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Value}"
                        Header="参数值" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding Unit}"
                        Header="单位" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="参数描述" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>